<?xml version="1.0"?>
<!--
  PROYECTO arm_bst v4 - Brazo de 4 GDL + gripper JAULA/PALA + sensor F/T en la muneca
  + 5 cubos de distinto peso sobre pedestales ANGOSTOS.   Gazebo Harmonic.  Unidades: m, kg, rad.

  Ejecutar:   gz sim -r worlds/brazo_cubos.sdf

  El gripper ENCAPSULA el cubo sin apretarlo:
    - Abajo : dos labios naranjas (uno por dedo) quedan bajo el cubo y lo cargan.
    - Lados : las placas de los dedos cierran hasta 31 mm del centro (cubo = 30 mm): 1-2 mm de holgura.
              Tope mecanico: finger_*_joint llega como maximo a 0.024.
    - Frente/atras: dos paredes azules fijas a la palma, a 42 mm del centro (12 mm de holgura).
    - Arriba: la palma, a ~2 cm de la tapa del cubo.
  Fuerza de cierre ~0: el cubo queda "en jaula" y no se aprieta.
  v5: SIN DetachableJoint (arrancaban soldando los cubos a la mano). El cubo lo carga la jaula.
  Pedestal: 5 cm (radial) x 2.4 cm (tangencial) x 8 cm; el cubo (6 cm) sobresale 18 mm por lado.

  Cubos (todos de 0.06 m de lado):
    cubo1  rojo        300 g   q1=-0.6 rad   r=0.40 m
    cubo2  azul         60 g   q1=-0.3 rad   r=0.46 m
    cubo3  amarillo    450 g   q1=+0.0 rad   r=0.42 m
    cubo4  verde       120 g   q1=+0.3 rad   r=0.46 m
    cubo5  morado      200 g   q1=+0.6 rad   r=0.40 m
-->
<sdf version="1.9">
  <world name="arm_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Gravedad explicita = la constante GRAV del programa (el default de Gazebo es 9.8) -->
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>1 1 1 1</diffuse>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="arm">

      <!-- Base fija al mundo -->
      <link name="base">
        <inertial>
          <pose>0 0 0.04 0 0 0</pose>
          <mass>5.0</mass>
          <inertia><ixx>0.0187</ixx><iyy>0.0187</iyy><izz>0.025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
      <joint name="fixed_base" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- Torre (gira en Z: q1) -->
      <link name="tower">
        <pose>0 0 0.08 0 0 0</pose>
        <inertial>
          <pose>0 0 0.05 0 0 0</pose>
          <mass>1.5</mass>
          <inertia><ixx>0.0026</ixx><iyy>0.0026</iyy><izz>0.0027</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
      <joint name="joint1" type="revolute">
        <parent>base</parent>
        <child>tower</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-3.14</lower><upper>3.14</upper><effort>100</effort></limit>
          <dynamics><damping>0.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Brazo superior: hombro en z=0.18, L1 = 0.40 -->
      <link name="upper_arm">
        <pose>0 0 0.18 0 0 0</pose>
        <inertial>
          <pose>0 0 0.20 0 0 0</pose>
          <mass>1.0</mass>
          <inertia><ixx>0.01387</ixx><iyy>0.01387</iyy><izz>0.00107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.40</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
        <visual name="axis_marker">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="joint2" type="revolute">
        <parent>tower</parent>
        <child>upper_arm</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.8</lower><upper>1.8</upper><effort>100</effort></limit>
          <dynamics><damping>0.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Antebrazo: codo en z=0.58, L2 = 0.35 -->
      <link name="forearm">
        <pose>0 0 0.58 0 0 0</pose>
        <inertial>
          <pose>0 0 0.175 0 0 0</pose>
          <mass>0.8</mass>
          <inertia><ixx>0.0084</ixx><iyy>0.0084</iyy><izz>0.00048</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.175 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.35</size></box></geometry>
          <material><ambient>0.2 0.8 0.3 1</ambient><diffuse>0.2 0.8 0.3 1</diffuse></material>
        </visual>
        <visual name="axis_marker">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="joint3" type="revolute">
        <parent>upper_arm</parent>
        <child>forearm</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-2.4</lower><upper>2.4</upper><effort>60</effort></limit>
          <dynamics><damping>0.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Muneca (4a articulacion, pitch): muneca en z=0.93.  Queda ARRIBA del sensor F/T -->
      <link name="wrist">
        <pose>0 0 0.93 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="joint4" type="revolute">
        <parent>forearm</parent>
        <child>wrist</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-2.8</lower><upper>2.8</upper><effort>20</effort></limit>
          <dynamics><damping>0.3</damping></dynamics>
        </axis>
      </joint>

      <!-- Palma: 0.3 kg.  Palma + dedos = 0.5 kg = TARA del programa -->
      <link name="hand">
        <pose>0 0 0.93 0 0 0</pose>
        <inertial>
          <pose>0 0 0.01 0 0 0</pose>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.0013</ixx>
            <iyy>0.0005</iyy>
            <izz>0.0017</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Mantén el resto visual y de colisión igual... -->
        <visual name="v">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>0.08 0.17 0.02</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>0.08 0.17 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      
        <!-- PARED wall_f: cuelga de la palma; 12 mm de holgura al cubo; evita que se salga en x -->
        <visual name="wall_f_v">
          <pose>0.046 0 0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.08 0.10</size></box></geometry>
          <material><ambient>0.2 0.5 0.9 0.6</ambient><diffuse>0.2 0.5 0.9 0.6</diffuse></material>
        </visual>
        <collision name="wall_f_c">
          <pose>0.046 0 0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.08 0.10</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <!-- PARED wall_b: cuelga de la palma; 12 mm de holgura al cubo; evita que se salga en x -->
        <visual name="wall_b_v">
          <pose>-0.046 0 0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.08 0.10</size></box></geometry>
          <material><ambient>0.2 0.5 0.9 0.6</ambient><diffuse>0.2 0.5 0.9 0.6</diffuse></material>
        </visual>
        <collision name="wall_b_c">
          <pose>-0.046 0 0.05 0 0 0</pose>
          <geometry><box><size>0.008 0.08 0.10</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
      </link>

      <!-- SENSOR DE FUERZA/TORQUE: mide todo lo que cuelga de la palma (palma+dedos+cubo) -->
      <joint name="wrist_ft_joint" type="fixed">
        <parent>wrist</parent>
        <child>hand</child>
        <sensor name="wrist_ft" type="force_torque">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>wrist_ft</topic>
          <force_torque>
            <frame>child</frame>
            <measure_direction>child_to_parent</measure_direction>
          </force_torque>
        </sensor>
      </joint>

      <!-- Dedo left: se cierra hacia el centro de la palma -->
      <link name="finger_l">
        <pose>0 0.065 0.95 0 0 0</pose>
        <inertial>
          <pose>0 0 0.05 0 0 0</pose>
          <mass>0.1</mass>
          <inertia><ixx>0.0000867</ixx><iyy>0.0001133</iyy><izz>0.0000333</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.06 0.02 0.10</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <collision name="c">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.06 0.02 0.10</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
      
        <!-- LABIO (pala): 12 mm hacia el centro, 15 mm de espesor, a ras de la punta del dedo -->
        <visual name="lip_v">
          <pose>0 -0.016 0.0925 0 0 0</pose>
          <geometry><box><size>0.06 0.012 0.015</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="lip_c">
          <pose>0 -0.016 0.0925 0 0 0</pose>
          <geometry><box><size>0.06 0.012 0.015</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="finger_l_joint" type="prismatic">
        <parent>hand</parent>
        <child>finger_l</child>
        <axis>
          <xyz expressed_in="__model__">0 -1 0</xyz>
          <limit><lower>0</lower><upper>0.024</upper><effort>40</effort></limit>
          <dynamics><damping>0.1</damping></dynamics>
        </axis>
      </joint>

      <!-- Dedo right: se cierra hacia el centro de la palma -->
      <link name="finger_r">
        <pose>0 -0.065 0.95 0 0 0</pose>
        <inertial>
          <pose>0 0 0.05 0 0 0</pose>
          <mass>0.1</mass>
          <inertia><ixx>0.0000867</ixx><iyy>0.0001133</iyy><izz>0.0000333</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.06 0.02 0.10</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <collision name="c">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.06 0.02 0.10</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
      
        <!-- LABIO (pala): 12 mm hacia el centro, 15 mm de espesor, a ras de la punta del dedo -->
        <visual name="lip_v">
          <pose>0 0.016 0.0925 0 0 0</pose>
          <geometry><box><size>0.06 0.012 0.015</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="lip_c">
          <pose>0 0.016 0.0925 0 0 0</pose>
          <geometry><box><size>0.06 0.012 0.015</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="finger_r_joint" type="prismatic">
        <parent>hand</parent>
        <child>finger_r</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>0</lower><upper>0.024</upper><effort>40</effort></limit>
          <dynamics><damping>.1</damping></dynamics>
        </axis>
      </joint>

      <!-- Controladores del brazo -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>joint1</joint_name>
        <p_gain>300</p_gain><i_gain>0</i_gain><d_gain>15</d_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>joint2</joint_name>
        <p_gain>500</p_gain><i_gain>5</i_gain><d_gain>20</d_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>joint3</joint_name>
        <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>15</d_gain>
      </plugin>
        <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>joint4</joint_name>
        <p_gain>40</p_gain><i_gain>0</i_gain><d_gain>2</d_gain>
      </plugin>

      <!-- Controladores del gripper: fuerza LIMITADA a 15 N con cmd_max/cmd_min -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>finger_l_joint</joint_name>
        <p_gain>40</p_gain><i_gain>0</i_gain><d_gain>2</d_gain><cmd_max>15</cmd_max><cmd_min>-15</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>finger_r_joint</joint_name>
        <p_gain>40</p_gain><i_gain>0</i_gain><d_gain>2</d_gain><cmd_max>15</cmd_max><cmd_min>-15</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
    </model>

    <!-- Pedestales y cubos -->
    <!-- Cubo 1 (rojo, 300 g) en q1=-0.6 rad, r=0.4 m -->
    <model name="pedestal1">
      <static>true</static>
      <pose>0.3301 -0.2259 0.04 0 0 -0.6</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cubo1">
      <pose>0.3301 -0.2259 0.1102 0 0 -0.6</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.0001800</ixx><iyy>0.0001800</iyy><izz>0.0001800</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Cubo 2 (azul, 60 g) en q1=-0.3 rad, r=0.46 m -->
    <model name="pedestal2">
      <static>true</static>
      <pose>0.4395 -0.1359 0.04 0 0 -0.3</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cubo2">
      <pose>0.4395 -0.1359 0.1102 0 0 -0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.06</mass>
          <inertia><ixx>0.0000360</ixx><iyy>0.0000360</iyy><izz>0.0000360</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.2 0.5 0.95 1</ambient><diffuse>0.2 0.5 0.95 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Cubo 3 (amarillo, 450 g) en q1=0.0 rad, r=0.42 m -->
    <model name="pedestal3">
      <static>true</static>
      <pose>0.4200 0.0000 0.04 0 0 0.0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.024 0.08</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cubo3">
      <pose>0.4200 0.0000 0.1102 0 0 0.0</pose>
      <link name="link">
        <inertial>
          <mass>0.45</mass>
          <inertia><ixx>0.0002700</ixx><iyy>0.0002700</iyy><izz>0.0002700</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Cubo 4 (verde, 120 g) en q1=0.3 rad, r=0.46 m -->
    <model name="pedestal4">
      <static>true</static>
